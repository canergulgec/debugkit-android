<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SampleApplication"
        android:label="DebugKit Sample"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".XmlActivity" android:label="XML screen" />

        <!-- Deep link targets for the Deep Links screen. -->
        <activity
            android:name=".ProductActivity"
            android:exported="true"
            android:label="Product">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="debugkit-sample" android:host="product" />
            </intent-filter>
            <!-- Never verifies (the domain hosts no assetlinks.json), to show the "not verified" state. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="debugkit.example.com" android:pathPrefix="/product" />
            </intent-filter>
            <!-- Deliberately missing BROWSABLE: opens from inside the app only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="debugkit-sample" android:host="internal" />
            </intent-filter>
        </activity>
    </application>
</manifest>
